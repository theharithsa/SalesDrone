# Public Firebase web configuration is included in src/lib/firebase.ts.
# Obtain these public browser keys from the same Firebase project.
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_APPCHECK_KEY=
VITE_FIREBASE_APPCHECK_PROVIDER=enterprise
# Only for local Firebase Emulator Suite; never set this in a production build.
VITE_USE_EMULATORS=false
