{
  "name": "salesdrone",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "functions"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build:metadata && npm run build -w apps/web",
    "test": "npm test -w functions && node --test tests/*.test.ts && npm run test:components",
    "check": "npm run check -w apps/web",
    "api:docs": "node scripts/openapi.mjs",
    "emulators": "firebase emulators:start --project demo-salesdrone",
    "test:emulator": "firebase emulators:exec --project demo-salesdrone --only firestore,auth,storage 'npm run test:emulator -w functions'",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "security:scan": "node scripts/check-secrets.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "build:metadata": "node scripts/build-release.mjs",
    "skills:check": "node scripts/check-skills.mjs",
    "docs:settings": "node scripts/build-settings-docs.mjs",
    "docs:check": "node scripts/build-settings-docs.mjs --check && node scripts/build-skill-tree.mjs --check && node scripts/build-product-guide.mjs --check",
    "release:readiness": "node scripts/check-readiness.mjs",
    "release:postcheck": "node scripts/post-deploy.mjs",
    "skills:tree": "node scripts/build-skill-tree.mjs",
    "docs:product": "node scripts/build-product-guide.mjs",
    "qa": "node scripts/run-test-suite.mjs",
    "design:check": "node --test tests/material-design.test.ts && npm run design:forms && npm run check && npm run build && node scripts/check-design-build.mjs",
    "design:dev": "node scripts/design-dev.mjs",
    "design:forms": "node scripts/check-material-forms.mjs",
    "review:mobile": "node scripts/review-mobile.mjs",
    "lint": "node scripts/lint.mjs",
    "test:components": "vitest run",
    "release:plan": "node scripts/plan-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "version": "2.6.0"
}
