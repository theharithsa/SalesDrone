SDR_REGION=asia-south1
APP_CHECK_MODE=enforce
# CURSOR_SECRET is a Secret Manager binding; keep it stable across deployments.

# Public model identifier. Store GEMINI_API_KEY with Firebase Secret Manager, never here.
GEMINI_MODEL=gemini-3.5-flash-lite

DYNATRACE_TENANT_URL=https://your-environment.live.dynatrace.com
# DYNATRACE_API_TOKEN is a Secret Manager binding. No token value belongs here.
